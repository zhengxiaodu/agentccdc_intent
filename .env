# 管理中心配置
MNG_URL=http://localhost:7009

# Workspace 管理器配置
# WS_MANAGER_TYPE: local（本地文件系统）或 docker（Docker 容器）
WS_MANAGER_TYPE=local
WS_BASEDIR=./workspaces
WS_TTL=3600

# Docker Workspace 配置（WS_MANAGER_TYPE=docker 时生效）
# base_image 是容器基础镜像，默认 python:3.11-slim
DOCKER_BASE_IMAGE=python:3.11-slim
# 容器内安装的 Node.js 版本（为空则不安装）
DOCKER_NODE_VERSION=
# 额外 pip 包（逗号分隔，例如 numpy,pandas）
DOCKER_EXTRA_PIP=

# 外部技能目录
EXTERNAL_SKILLS_DIR=./external_skills