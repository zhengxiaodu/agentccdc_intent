# PostgreSQL 会话持久化配置
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=zxdzxd.123
PG_DATABASE=agentscope
PG_DSN=postgresql://postgres:zxdzxd.123@localhost:5432/agentscope

# 文件上传配置
UPLOAD_MAX_SIZE_MB=10

# Langfuse 可观测性配置
LANGFUSE_PUBLIC_KEY=pk-lf-8a971ada-d691-4c57-b1c4-df081c3881e2
LANGFUSE_SECRET_KEY=sk-lf-6d3177f5-fdcf-4e01-8d71-5eb157a8e4e7
