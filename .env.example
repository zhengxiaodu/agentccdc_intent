OPENAI_API_KEY=your-openai-api-key
BOCHA_API_KEY=sk-b2456820150d48a68c15a0f76ded1eef

# JWT 鉴权配置
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRE_HOURS=8

# 第三方管理系统登录校验接口
# AUTH_MOCK=true 时使用内置模拟数据,生产环境应改为 false 并配置真实接口
AUTH_MOCK=true
AUTH_API_URL=https://example.com/api/auth/verify
AUTH_API_KEY=your-third-party-auth-api-key

# Redis 会话存储配置
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_TTL=86400

# PostgreSQL 会话持久化配置
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=zxdzxd.123
PG_DATABASE=agentscope

# 文件上传配置
UPLOAD_MAX_SIZE_MB=10

# Langfuse 可观测性配置（留空则不启用追踪）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com

# 管理中心地址
MNG_URL=http://localhost:7009

# Workspace 管理器配置
# WS_MANAGER_TYPE: local（本地文件系统）或 docker（Docker 容器）
WS_MANAGER_TYPE=local
WS_BASEDIR=./workspaces
WS_TTL=3600

# 外部技能目录
EXTERNAL_SKILLS_DIR=./external_skills